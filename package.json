{
  "name": "openpub",
  "version": "0.0.0",
  "private": true,
  "description": "OpenPub - 开源多平台内容分发中枢",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "desktop:dev": "pnpm --filter @openpub/desktop-app tauri dev",
    "desktop:build": "pnpm --filter @openpub/desktop-app tauri build",
    "create-adapter": "node scripts/create-adapter.mjs"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}